# Local Docker Compose settings. Change both values before running locally.
PGUSER=college_app
PGPASSWORD=change-this-local-password
PGDATABASE=college_live
PGHOST_PORT=5433

APP_ENV=development
JWT_SECRET_KEY=change-this-local-development-secret
CORS_ORIGINS=http://localhost:5173

FRONTEND_PORT=80

# Outbound Email (SMTP) for sending 'OTP from INPAND' to real user inboxes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=INPAND Security <noreply@collegeportal.edu>
SMTP_USE_TLS=true
