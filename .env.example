# Local Docker Compose settings. Change both values before running locally.
PGUSER=college_app
PGPASSWORD=change-this-local-password
PGDATABASE=college_live
PGHOST_PORT=5433

APP_ENV=development
JWT_SECRET_KEY=change-this-local-development-secret
CORS_ORIGINS=http://localhost:5173

FRONTEND_PORT=80

# Outbound Email (SMTP) for sending OTPs. For Gmail, use the Gmail account and
# its 16-character App Password (not the normal account password). The sender
# address defaults to SMTP_USER; set SMTP_FROM_EMAIL only for a verified alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IIET Portal Security
SMTP_USE_TLS=true
