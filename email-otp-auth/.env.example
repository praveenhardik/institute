# Server Port
PORT=4000

# Email Credentials for Nodemailer (Gmail App Password)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Optional Custom SMTP Host/Port (Defaults to Gmail: smtp.gmail.com:465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# OTP Expiration in Minutes (Default: 5)
OTP_EXPIRY_MINUTES=5
